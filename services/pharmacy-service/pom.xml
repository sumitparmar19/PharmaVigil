<?xml version="1.0" encoding="UTF-8"?>
<!-- pharmacy-service: Pharmacy counter: drugs, lots, FEFO dispensing, side-effect reports and safety warnings. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.pharmavigil</groupId>
    <artifactId>pharmavigil-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>pharmacy-service</artifactId>
  <name>pharmacy-service</name>

  <properties>
    <coverage.skip>true</coverage.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.pharmavigil</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
