<?xml version="1.0" encoding="UTF-8"?>
<!--
  PharmaVigil Java services: Maven parent POM.
  Pins Spring Boot, shared plugin config (JaCoCo coverage gate, Surefire/Failsafe)
  and the module list so every service builds and tests the same way.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.pharmavigil</groupId>
  <artifactId>pharmavigil-services</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>PharmaVigil services</name>

  <modules>
    <module>common</module>
    <module>pharmacy-service</module>
    <module>intake-gateway</module>
    <module>case-service</module>
    <module>signal-service</module>
    <module>submission-gateway</module>
  </modules>

  <properties>
    <onnxruntime.version>1.31.0</onnxruntime.version>
    <anthropic-java.version>3.1.0</anthropic-java.version>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- Line-coverage floor per service (BUILD_INSTRUCTIONS §5.9). Modules may raise it. -->
    <coverage.minimum>0.70</coverage.minimum>
    <!-- Skeleton modules switch the gate off until they hold real code. -->
    <coverage.skip>false</coverage.skip>
    <springdoc.version>3.1.1</springdoc.version>
    <!-- Database used by the repository/integration tests: oracle (default) or mssql (-Pmssql). -->
    <pv.db>oracle</pv.db>
  </properties>

  <profiles>
    <profile>
      <id>mssql</id>
      <properties>
        <pv.db>mssql</pv.db>
      </properties>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.pharmavigil</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.pharmavigil</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <pv.db>${pv.db}</pv.db>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <skip>${coverage.skip}</skip>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
