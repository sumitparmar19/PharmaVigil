# PharmaVigil environment variables. Copy to .env and fill in locally; never commit .env.
# Every secret the code reads is listed here (BUILD_INSTRUCTIONS §1).

# --- Optional: Claude drafts case narratives; without a key a deterministic template is used.
ANTHROPIC_API_KEY=
# Model id from the Anthropic docs; narrative drafting is skipped (template used) when unset.
CLAUDE_MODEL=

# --- Databases (Oracle is primary; SQL Server is the portability profile)
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_USER=pharmavigil
ORACLE_PASSWORD=
MSSQL_URL=jdbc:sqlserver://localhost:1433;databaseName=pharmavigil;encrypt=false
MSSQL_USER=sa
MSSQL_PASSWORD=

# --- Service URLs
SIGNAL_SERVICE_URL=http://localhost:8084

# --- Messaging
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ARTEMIS_BROKER_URL=tcp://localhost:61616
ARTEMIS_USER=
ARTEMIS_PASSWORD=

# --- Security: JWT signing secret shared by all services (at least 32 characters, random)
JWT_SECRET=
# Password for the demo logins (pharmacist, reviewer, admin) created by the "demo" profile; min 12 chars
PV_DEMO_PASSWORD=

# --- SOAP partner intake (WS-Security username token)
SOAP_PARTNER_USER=
# At least 12 characters; with either value empty every SOAP call is refused (ADR-009).
SOAP_PARTNER_PASSWORD=

# --- Model bundle for case-service (pv-ml java-bundle or a trained bundle); empty = manual coding
PV_MODEL_DIR=

# --- ICH E2B(R3) schema set (scripts/fetch-e2b-xsd.sh <dir>); empty = exports are never queueable
PV_E2B_XSD_DIR=

# --- Data platform
FAERS_FIRST_QUARTER=2019Q1
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_API_KEY=

# --- Service addresses used by pharmacy-service and the signal export
INTAKE_GATEWAY_URL=http://localhost:8082
# Folder written by `pv-ml export-signals` for signal-service; empty = no signal data is served
PV_SIGNALS_DIR=

# --- docker compose (docker-compose.yml). In compose, ORACLE_PASSWORD above is the database's SYSTEM password;
# each service connects as its own user (pv_pharmacy, pv_intake, pv_case, pv_signal, pv_submission) with this one.
PV_DB_PASSWORD=
# Optional folders mounted into the containers (defaults: the synthetic test model bundle, no signal data, ./.e2b-xsd)
MODEL_BUNDLE_DIR=
SIGNALS_DIR=
E2B_XSD_DIR=
# Browser smoke test (frontend/e2e): UI address and an optional pre-installed Chromium
PV_UI_URL=http://localhost:8080
PW_CHROMIUM_PATH=

# --- Observability (docs/OBSERVABILITY.md): true switches the OpenTelemetry Java agent on (traces to Jaeger)
PV_TRACING=false

# --- Data and ML runs (optional; defaults in parentheses)
# Table and download folders (data/lake, data/raw); Databricks Unity Catalog name (empty = local Delta)
PV_LAKE=
PV_RAW=
PV_CATALOG=
# Local Spark (all cores, 6g, 16) and PyTorch threads (all cores)
PV_SPARK_CORES=
PV_SPARK_DRIVER_MEMORY=
PV_SPARK_SHUFFLE_PARTITIONS=
PV_TORCH_THREADS=
# Memory cap for DuckDB in the ML jobs (larger work spills to disk); default 4GB.
PV_DUCKDB_MEMORY=

# --- Jenkins controller (ops/jenkins/docker-compose.yml; run-headless.sh sets all of these itself)
# Password of the local Jenkins admin user (choose one; never commit it)
JENKINS_ADMIN_PASSWORD=
# Group id of /var/run/docker.sock (`stat -c %g /var/run/docker.sock`), repository path and commit to build
DOCKER_GID=
PV_REPO_PATH=
PV_GIT_REF=
