# PharmaVigil environment variables. Copy to .env and fill in locally; never commit .env.
# Every secret the code reads is listed here (BUILD_INSTRUCTIONS §1).

# --- Optional: Claude drafts case narratives; without a key a deterministic template is used.
ANTHROPIC_API_KEY=
# Model id from the Anthropic docs; narrative drafting is skipped (template used) when unset.
CLAUDE_MODEL=

# --- Databases (Oracle is primary; SQL Server is the portability profile)
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_USER=pharmavigil
ORACLE_PASSWORD=
MSSQL_URL=jdbc:sqlserver://localhost:1433;databaseName=pharmavigil;encrypt=false
MSSQL_USER=sa
MSSQL_PASSWORD=

# --- Messaging
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ARTEMIS_BROKER_URL=tcp://localhost:61616
ARTEMIS_USER=
ARTEMIS_PASSWORD=

# --- Security (JWT signing secret, at least 32 random bytes, base64)
JWT_SECRET=

# --- SOAP partner intake (WS-Security username token)
SOAP_PARTNER_USER=
SOAP_PARTNER_PASSWORD=

# --- Data platform
FAERS_FIRST_QUARTER=2019Q1
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_API_KEY=
