# PharmaVigil ignore rules: no data, models, secrets or build output in git
# (BUILD_INSTRUCTIONS §5.11). Tiny test fixtures live under */tests/fixtures/.

# Secrets
.env
*.env.local

# Data and model artefacts
/data/raw/
/data/lake/
/data/cache/
*.parquet
!**/tests/fixtures/**/*.parquet
*.zip
*.onnx
!**/tests/fixtures/**/*.onnx
*.pt
*.ckpt
*.safetensors
mlruns/
mlartifacts/
/models/
/artifacts/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
spark-warehouse/
metastore_db/
derby.log
.ipynb_checkpoints/

# Java
target/
*.class
.idea/
*.iml
.vscode/

# Node / frontend
node_modules/
dist/
playwright-report/
test-results/

# Infrastructure
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Downloaded at build time (licence unclear, see docs/E2B_R3.md)
/services/common/src/main/xsd/ich/

# Model artefacts written by pv-ml (hashes go to analysis/models/MANIFEST.md)
/ml/artifacts/

# Tiny synthetic model bundle for the Java tests (ml: pv-ml java-bundle; listed in analysis/models/MANIFEST.md)
!/services/case-service/src/test/resources/model-bundle/*.onnx

# Official E2B(R3) schemas fetched for docker compose (scripts/fetch-e2b-xsd.sh .e2b-xsd)
/.e2b-xsd/
playwright-report/
test-results/

# Helm: dependency packages and lock files are rebuilt with `helm dependency build`
ops/helm/*/charts/
ops/helm/*/Chart.lock

# Throwaway kind secrets written by ops/kind/deploy.sh
.kind-secrets.env

# Terraform working files and state (state lives in Azure Storage, never in git)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.lock.hcl.bak
crash.log

# Live demo data and secrets on the server (ops/demo/fetch-demo-data.sh, OWNER_STEPS.md)
ops/demo/data/
ops/demo/.env
playwright-live-report/

# DuckDB spill files written while large queries run (data; never committed)
.tmp/
