{
  "uid": "pv-ai-quality",
  "title": "PharmaVigil · AI quality",
  "description": "How often reviewers keep the models' suggestions, model latency and how often cases fall back to manual work.",
  "tags": [
    "pharmavigil",
    "ai"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Not for clinical or regulatory use.** Spontaneous reports do not prove that a drug caused a reaction. Synthetic patients only.\n\nAI outputs are suggestions; a reviewer confirms every code, seriousness and duplicate flag. Acceptance is a feedback signal from reviewers, not a measured accuracy. With the synthetic test bundle (model names start with `fixture:`) these numbers mean nothing."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "MedDRA coder: kept by reviewers",
      "description": "Accepted / (accepted + corrected) code suggestions in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pv_review_decisions_total{field=\"PT\",outcome=\"accepted\"}[$__range])) / sum(increase(pv_review_decisions_total{field=\"PT\",outcome=~\"accepted|corrected\"}[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "id": 2
    },
