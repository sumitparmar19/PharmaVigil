      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Stage failures per minute",
      "description": "Failed attempts; after three retries a message goes to its .dlq topic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
