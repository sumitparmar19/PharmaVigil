# Caddy in front of the live demo: HTTPS with an automatic Let's Encrypt certificate for PV_DEMO_HOST (a free
# hostname derived from the server's public IP, e.g. 203-0-113-7.sslip.io), HTTP redirected to HTTPS, the
# read-only Grafana under /grafana/, everything else to the UI's nginx (which routes /api and applies the limits).
{
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			idle 2m
		}
	}
}

{$PV_DEMO_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 64KB
	}
	handle /grafana/* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy frontend:8080
	}
	log {
		output stdout
		format console
	}
}
